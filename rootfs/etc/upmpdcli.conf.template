# UPnP/DLNA 수신 장치 이름 (손님 스마트폰에 표시될 이름)
friendlyname = ${SPEAKER_NAME} (DLNA)

# 로컬 MPD 오디오 엔진 바인딩
mpdhost = 127.0.0.1
mpdport = 6600

# UPnP / DLNA 네트워크 및 포트 설정
# upnpip를 지정하지 않으면 libupnp가 첫 번째 비루프백 LAN 인터페이스(192.168.x.x)를 자동 감지하여 바인딩합니다.
# (0.0.0.0 설정 시 UPNP_E_INVALID_INTERFACE 오류 발생하므로 비워둠)
# upnpip =

# 방화벽(OPNsense 등) 정책과 일치하도록 DLNA/UPnP 수신 포트를 49152번으로 고정 바인딩
upnpport = 49152

# OpenHome 프로토콜 및 런타임 설정
openhome = 1
radiolist = /usr/share/upmpdcli/radio_defs.xml
pkgdatadir = /usr/share/upmpdcli
pidfile = /var/run/upmpdcli.pid
logfilename = /dev/stdout
loglevel = 2
checkrate = 0
